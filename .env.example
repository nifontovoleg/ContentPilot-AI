# Copy to .env locally. Never commit real credentials.
DATABASE_URL=sqlite:///./data/content_platform.db
POSTING_MODE=demo

# Optional AI generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_FALLBACK_LOCAL=true

# Telegram Bot API
TELEGRAM_BOT_TOKEN=

# VK API
VK_ACCESS_TOKEN=

# Instagram Graph API
IG_ACCESS_TOKEN=

# WordPress REST API
WP_URL=
WP_USER=
WP_APP_PASSWORD=

# Mailchimp Marketing API
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_REPLY_TO=
